KALPI_ENVIRONMENT=local
# Keep false unless a verified official client, credential provider, account permissions,
# instrument resolver, reconciliation worker, and explicit deployment approval are in place.
KALPI_LIVE_TRADING_ENABLED=false
KALPI_RETRY_ATTEMPTS=3
KALPI_RETRY_BACKOFF_SECONDS=0.0
KALPI_IDEMPOTENCY_WAIT_SECONDS=30
KALPI_LOG_LEVEL=INFO
# Comma-separated deterministic mock rejections for local/demo testing only, e.g. FAIL
KALPI_MOCK_FAIL_SYMBOLS=
# KALPI_HOST_PORT=8000
# Broker credentials/tokens belong in a secret manager in a real deployment; never add them here.
